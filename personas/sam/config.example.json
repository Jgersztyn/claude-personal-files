    "Bash(gh api:*)", "Bash(gh pr review:*)", "Bash(gh pr comment:*)", "Bash(gh pr merge:*)",
    "Bash(gh pr edit:*)", "Bash(gh pr close:*)", "Bash(gh issue:*)",
