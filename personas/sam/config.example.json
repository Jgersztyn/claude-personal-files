    "Bash(git blame:*)", "Bash(git rev-parse:*)", "Bash(git ls-files:*)", "Bash(git merge-base:*)", "Bash(git checkout:*)", "Bash(git restore:*)", "Bash(git clean -fd:*)",
    "Bash(gh pr view:*)", "Bash(gh pr diff:*)",
